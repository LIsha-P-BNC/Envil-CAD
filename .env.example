# Anvil auth backend - deployment values.
#
# Copy this file to `.env` NEXT TO THE EXECUTABLE and fill in the real values.
# That is the only place the app looks. Plain .env syntax: Key=Value, '#' comments.
#
# Ship a filled-in `.env` inside the installer/zip and a new machine needs no setup.
# NEVER commit the filled-in `.env` - it is listed in .gitignore.
#
# WARNING: a key shipped beside the exe is readable by anyone holding the exe. It removes
# setup friction, not exposure. What actually protects the endpoint is server-side rate
# limiting / per-email throttling on /register.

# REQUIRED: full deployment api-key, sent in the "api-key" request header.
ApiKey=dt_1xxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED: project_id sent when requesting an OTP.
ProjectId=2

# Optional: server override. The endpoint URLs are compiled in full (see
# include/anvil_auth/anvil_api_defs.h); set this only if endpoints are declared
# there as bare paths ("/api/...") to point them at a different host.
#ApiBase=https://bnc-ai.com

# Optional: local session lifetime in days when the server reports no expiry (default 30).
#SessionDays=30
